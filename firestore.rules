rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTripMember(tripId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/trips/$(tripId)/members/$(request.auth.uid));
    }

    function isTripCreator(tripId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/trips/$(tripId)).data.createdBy == request.auth.uid;
    }

    match /trips/{tripId} {
      allow read: if isSignedIn() &&
        (resource.data.createdBy == request.auth.uid || isTripMember(tripId));

      allow create: if isSignedIn() &&
        request.resource.data.createdBy == request.auth.uid;

      allow update: if isSignedIn() &&
        resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if isSignedIn() &&
        resource.data.createdBy == request.auth.uid;

      match /members/{memberId} {
        // Any member of the trip (or its creator) can read the full member
        // list; this also covers listing the members collection, since the
        // rule is evaluated per-document against the same condition.
        allow read: if isSignedIn() &&
          (memberId == request.auth.uid || isTripCreator(tripId) || isTripMember(tripId));

        allow create: if isSignedIn() &&
          memberId == request.auth.uid &&
          request.resource.data.userId == request.auth.uid &&
          (
            request.resource.data.role == 'member' ||
            (request.resource.data.role == 'admin' && isTripCreator(tripId))
          );

        // Membership is immutable once created: no role changes,
        // no editing another member's document, no deletions.
        allow update, delete: if false;
      }
    }

    // Narrow invite-code -> tripId lookup, kept separate from /trips so a
    // user who is not yet a trip member can resolve a code without needing
    // read access to trip documents themselves (which stay restricted to
    // members/creator by the rules above).
    match /inviteCodes/{inviteCode} {
      // Any signed-in user may look up a single, known invite code by ID.
      // This only ever reveals a tripId, never trip content.
      allow get: if isSignedIn();

      // Never allow enumerating all invite codes.
      allow list: if false;

      // Only the creator of the referenced trip may register its code,
      // and only once (immutable afterwards).
      allow create: if isSignedIn() &&
        request.resource.data.tripId is string &&
        get(/databases/$(database)/documents/trips/$(request.resource.data.tripId)).data.createdBy == request.auth.uid;

      allow update, delete: if false;
    }
  }
}
